# =============================================================================
# CONFIGURACIÓN DEL ENTORNO - SECURE WEB APP
# =============================================================================
# Copia este archivo como .env y configura los valores según tu entorno

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# SEGURIDAD - JWT
# -----------------------------------------------------------------------------
# Secreto para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN!)
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion-123456789

# -----------------------------------------------------------------------------
# SEGURIDAD - COOKIES
# -----------------------------------------------------------------------------
# Secreto para firmar cookies (CAMBIAR EN PRODUCCIÓN!)
COOKIE_SECRET=otro-secreto-para-cookies-cambiar-tambien-987654321

# -----------------------------------------------------------------------------
# WEBAUTHN - AUTENTICACIÓN BIOMÉTRICA
# -----------------------------------------------------------------------------
# Nombre de tu aplicación (se muestra al usuario durante autenticación)
RP_NAME=Secure Web App

# ID del Relying Party (tu dominio sin protocolo ni puerto)
# En desarrollo: localhost
# En producción: tu-dominio.com
RP_ID=localhost

# Origen permitido (URL completa de tu aplicación)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# CORS - Orígenes Permitidos
# -----------------------------------------------------------------------------
# Lista de orígenes separados por coma que pueden hacer peticiones
# Ejemplo: http://localhost:3000,https://tu-dominio.com
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Nivel de logging: error, warn, info, debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# BASE DE DATOS (Opcional - SQLite por defecto)
# -----------------------------------------------------------------------------
# Si quieres usar PostgreSQL en lugar de SQLite:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/secure_app

# -----------------------------------------------------------------------------
# PRODUCCIÓN
# -----------------------------------------------------------------------------
# En producción, asegúrate de:
# 1. NODE_ENV=production
# 2. Cambiar JWT_SECRET y COOKIE_SECRET por valores seguros
# 3. Usar HTTPS (certificado SSL)
# 4. Configurar RP_ID y ORIGIN con tu dominio real
# 5. Configurar ALLOWED_ORIGINS correctamente
